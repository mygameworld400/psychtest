      ],
      "reverse": false
    },
    {
      "id": "NOW_021",
      "type": "likert",
      "text": "예전에 끝난 문제라고 했지만 사실 마음속에 아직 남아 있다",
      "dimensions": [
        "미해결갈등"
      ],
      "reverse": false
    },
    {
      "id": "NOW_022",
      "type": "likert",
      "text": "상대의 말을 예전만큼 그대로 믿기 어렵다",
      "dimensions": [
        "신뢰손상",
        "상대말불신"
      ],
      "reverse": false
