  "items": [
    {
      "id": "NOW_001",
      "type": "likert",
      "text": "요즘 연인과 연락하는 것 자체가 피곤할 때가 많다",
      "dimensions": [
        "연락피로",
        "관계에너지방전"
      ],
      "reverse": false
    },
    {
      "id": "NOW_002",
      "type": "likert",
      "text": "만나기로 한 날이 다가오면 기대보다 부담이 먼저 든다",
      "dimensions": [
        "만남의무감",
        "관계압박감"
      ],
      "reverse": false
    },
    {
      "id": "NOW_003",
      "type": "likert",
      "text": "상대의 메시지를 보고도 답장을 미루고 싶을 때가 많다",
      "dimensions": [
        "연락피로",
        "정서적거리욕구"
      ],
      "reverse": false
    },
    {
      "id": "NOW_004",
      "type": "likert",
      "text": "상대와 대화하면 비슷한 이야기를 또 반복하게 될 것 같다",
      "dimensions": [
        "대화피로",
        "관계무기력"
      ],
      "reverse": false
    },
    {
      "id": "NOW_005",
      "type": "likert",
      "text": "요즘은 혼자 있을 때 가장 편하다",
      "dimensions": [
        "혼자회복욕구"
      ],
      "reverse": false
    },
    {
      "id": "NOW_006",
      "type": "likert",
      "text": "상대가 나에게 계속 이유를 묻거나 다가오면 더 멀어지고 싶다",
      "dimensions": [
        "동굴침입거부감",
        "관계압박감"
      ],
      "reverse": false
    },
    {
      "id": "NOW_007",
      "type": "likert",
      "text": "상대가 싫다기보다 그냥 아무것도 신경 쓰고 싶지 않다",
      "dimensions": [
        "감정소진",
        "혼자회복욕구"
      ],
      "reverse": false
    },
    {
      "id": "NOW_008",
      "type": "likert",
      "text": "상대를 만나지 않는 날에도 그 사람이 보고 싶다",
      "dimensions": [
        "상대그리움",
        "애정잔존"
      ],
      "reverse": false
    },
    {
      "id": "NOW_009",
      "type": "likert",
      "text": "상대가 힘들다고 하면 여전히 걱정되고 도와주고 싶다",
      "dimensions": [
        "상대행복관심",
        "정서적애착"
      ],
      "reverse": false
    },
    {
      "id": "NOW_010",
      "type": "likert",
      "text": "예전처럼 상대에게 설레는 느낌은 많이 줄었다",
      "dimensions": [
        "설렘잔존"
      ],
      "reverse": true
    },
    {
      "id": "NOW_011",
      "type": "likert",
      "text": "스킨십이나 신체적 가까움이 부담스럽게 느껴질 때가 있다",
      "dimensions": [
        "신체적거리욕구"
      ],
      "reverse": false
    },
    {
      "id": "NOW_012",
      "type": "likert",
      "text": "상대에게 아직 애정이 있다고 느낀다",
      "dimensions": [
        "애정잔존"
      ],
      "reverse": false
    },
    {
      "id": "NOW_013",
      "type": "likert",
      "text": "상대와의 관계를 완전히 끝내는 모습을 상상하면 마음이 편해진다",
      "dimensions": [
        "관계종료의사",
        "이별사고빈도"
      ],
      "reverse": false
    },
    {
      "id": "NOW_014",
      "type": "likert",
      "text": "헤어지는 생각을 최근 자주 해봤다",
      "dimensions": [
        "이별사고빈도"
      ],
      "reverse": false
    },
    {
      "id": "NOW_015",
      "type": "likert",
      "text": "문제가 해결된다면 이 관계를 계속 이어가고 싶다",
      "dimensions": [
        "관계유지의지",
        "관계회복의지"
      ],
      "reverse": false
    },
    {
      "id": "NOW_016",
      "type": "likert",
      "text": "상대와 다시 잘 지낼 방법을 찾아보고 싶은 마음이 있다",
      "dimensions": [
        "관계회복의지"
      ],
      "reverse": false
    },
    {
      "id": "NOW_017",
      "type": "likert",
      "text": "아무리 이야기해도 상대는 달라지지 않을 것 같다",
      "dimensions": [
        "상대변화기대"
      ],
      "reverse": true
    },
    {
      "id": "NOW_018",
      "type": "likert",
      "text": "우리 관계는 노력하면 좋아질 수 있다고 생각한다",
      "dimensions": [
        "관계개선기대"
      ],
      "reverse": false
    },
    {
      "id": "NOW_019",
      "type": "likert",
      "text": "싸우는 것조차 이제는 귀찮게 느껴진다",
      "dimensions": [
        "관계무기력",
        "감정소진"
      ],
      "reverse": false
    },
    {
      "id": "NOW_020",
      "type": "likert",
      "text": "상대에게 쌓인 서운함이 한두 가지가 아니다",
      "dimensions": [
